# Postgres connection string (Neon). Pooled connection recommended for Vercel.
DATABASE_URL=

# --- Model provider (Phase 2) ---
# Which provider runStructured() uses: "gemini" or "anthropic".
# ANTHROPIC is the intended provider for daily use: the Gemini free tier caps at
# ~20 requests/DAY on the Flash models, which is too tight to plan a day with.
LLM_PROVIDER=anthropic

# Google Gemini API key (used when LLM_PROVIDER=gemini). Server-side only.
GEMINI_API_KEY=

# Anthropic API key (used when LLM_PROVIDER=anthropic). Server-side only.
ANTHROPIC_API_KEY=

# Optional per-role model pins. Defaults live in lib/ai/models.ts
# Roles: COMPOSE (daily planner), CAPTURE (lightweight), REASON (breakdown +
# the timetable parse).
#
# Ids are checked at boot against the provider's own model list — Gemini
# ListModels, Anthropic GET /v1/models. Watch for the [models] line in the log:
#   [models] ✓ all 3 configured anthropic model ids exist: compose=…
# A ✗ names the bad id and suggests near matches. Never guess an id here.
#
# Anthropic defaults: chat=claude-haiku-4-5, compose=claude-sonnet-5,
# capture=claude-haiku-4-5, reason=claude-sonnet-5. Ids carry NO date suffix.
# CHAT runs on every assistant message, so it is deliberately the cheap model.
# ANTHROPIC_CHAT_MODEL=claude-opus-5 pins it higher if routing quality slips.
# Gemini free tier: ~20 requests/DAY on 3.6/3.7 Flash, 500/day on 3.5 Flash Lite.
# Restart `next dev` after changing these — Next does not hot-reload .env.local.
# GEMINI_COMPOSE_MODEL=
# GEMINI_CAPTURE_MODEL=
# GEMINI_REASON_MODEL=
# ANTHROPIC_COMPOSE_MODEL=
# ANTHROPIC_CAPTURE_MODEL=
# ANTHROPIC_REASON_MODEL=

# The single passphrase that unlocks the app. (Phase 1 auth)
APP_PASSPHRASE=

# Secret used to sign the session cookie. MINIMUM 16 CHARACTERS (lib/session.ts).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# That is every variable the app reads. Google Calendar sync, .ics export and
# the /api/capture endpoint were CUT, not deferred — see SPEC.md section 7.
