# Postgres connection string (Neon). Pooled connection recommended for Vercel.
DATABASE_URL=

# Anthropic API key. Server-side only — never exposed to the browser. (Phase 2+)
ANTHROPIC_API_KEY=

# The single passphrase that unlocks the app. (Phase 1 auth)
APP_PASSPHRASE=

# Secret used to sign the session cookie. Use a long random string. (Phase 1 auth)
SESSION_SECRET=

# Bearer token the iOS Shortcut sends to /api/capture. (Phase 6)
CAPTURE_TOKEN=

# Google OAuth client for Calendar sync. (Phase 6)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Key used to encrypt the stored Google refresh token. (Phase 6)
ENCRYPTION_KEY=
