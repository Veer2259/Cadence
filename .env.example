# Postgres connection string (Neon). Pooled connection recommended for Vercel.
DATABASE_URL=

# --- Model provider (Phase 2) ---
# Which provider runStructured() uses: "gemini" or "anthropic".
LLM_PROVIDER=gemini

# Google Gemini API key (used when LLM_PROVIDER=gemini). Server-side only.
GEMINI_API_KEY=

# Anthropic API key (used when LLM_PROVIDER=anthropic). Server-side only.
ANTHROPIC_API_KEY=

# Optional per-role model pins, to ride out a model outage without a code change.
# Defaults live in lib/ai/models.ts (gemini-3.7-flash / gemini-3.5-flash-lite).
# GEMINI_COMPOSE_MODEL=
# GEMINI_CAPTURE_MODEL=
# ANTHROPIC_COMPOSE_MODEL=
# ANTHROPIC_CAPTURE_MODEL=

# The single passphrase that unlocks the app. (Phase 1 auth)
APP_PASSPHRASE=

# Secret used to sign the session cookie. Use a long random string. (Phase 1 auth)
SESSION_SECRET=

# Bearer token the iOS Shortcut sends to /api/capture. (Phase 6)
CAPTURE_TOKEN=

# Google OAuth client for Calendar sync. (Phase 6)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Key used to encrypt the stored Google refresh token. (Phase 6)
ENCRYPTION_KEY=
